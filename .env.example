# 复制此文件为 .env 并按需修改
# cp .env.example .env

# LLM CLI 工具调用命令（含所有必要参数）
# 支持两种模式，脚本会自动适配：
#   1. Claude: claude --dangerously-skip-permissions
#   2. Cursor: cursor-agent -p --force
#
# 示例：
#   claude --dangerously-skip-permissions
#   cursor-agent -p --force
CLI_TOOL="claude --dangerously-skip-permissions"

# Stage 4 分析链路版本（v2=默认现有链路；v3=精炼升级+对抗验证+机器核账）
# ANALYZE_PROMPT_VERSION=v2
# v3 每次运行 verify 总预算（条）与每 CLI 批大小
# VERIFY_MAX_PER_RUN=50
# VERIFY_BATCH_SIZE=20
