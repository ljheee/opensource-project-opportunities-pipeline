.DS_Store
*/.DS_Store

__pycache__/
*.pyc
.env
# SQLite WAL 模式产生的辅助文件，不应提交到 repo（pipeline.db 在 close 后会自动 checkpoint，
# 正常 push 时这两个文件为空或不存在；若存在说明有进程仍持有连接，强行提交会导致 remote
# 拿到不一致的 DB 快照）
data/*.db-wal
data/*.db-shm
# 进程互斥锁文件（运行时临时文件，不需要版本追踪）
data/.pipeline.lock
# verify LLM 裁决临时文件（ingest 校验后才落正式日志）
data/verify_log/.pending_*
# LLM 运行时生成的临时执行脚本（决策已写入 DB，脚本本身无需版本追踪）
scripts/
stages/analyze*.py
stages/stage*.py
stages/filter*.py

# 运行日志
*.log

# LLM 生成的根目录临时分析脚本
/run_analysis.py
/process_*.py
/process_*_data.json
/task_*_eval.json
/test_write*.py

# Claude Code 本地配置（含个人权限设置，不入库）
/.claude/
data/verify_log/scratch/
data/.apply_batch_*.py

# LLM 临时脚本（verify / judge / apply 各种阶段生成的临时 .py 脚本）
data/.verify_batch_*.py
data/.judge_batch_*.py
data/.apply_*.py
data/.process_*.py
data/.fetch_*.py
data/.analyze_*.py
